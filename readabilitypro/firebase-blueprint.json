{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User account information and subscription status",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "subscriptionTier": { "type": "string", "enum": ["free", "premium"] },
        "stripeCustomerId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "subscriptionTier"]
    },
    "Analysis": {
      "title": "Readability Analysis",
      "description": "Results of a text readability analysis",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "text": { "type": "string" },
        "title": { "type": "string" },
        "scores": {
          "type": "object",
          "properties": {
            "fleschEase": { "type": "number" },
            "fleschKincaid": { "type": "number" },
            "gunningFog": { "type": "number" }
          }
        },
        "metrics": {
          "type": "object",
          "properties": {
            "sentences": { "type": "integer" },
            "words": { "type": "integer" },
            "syllables": { "type": "integer" },
            "complexWords": { "type": "integer" }
          }
        },
        "improvedVersions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": { "type": "string" },
              "text": { "type": "string" }
            }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "text", "scores", "metrics", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile document"
    },
    "/users/{userId}/analyses/{analysisId}": {
      "schema": "Analysis",
      "description": "Collection of analysis reports for a user"
    }
  }
}
